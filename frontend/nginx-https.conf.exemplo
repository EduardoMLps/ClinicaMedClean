# Med Flow - nginx com HTTPS (exemplo de producao, correcao B7)
#
# Como usar:
#  1. Obtenha um certificado (ex.: Let's Encrypt/certbot) para o seu dominio.
#  2. Troque "clinica.exemplo.com.br" pelo seu dominio.
#  3. No Dockerfile do frontend, copie este arquivo no lugar do nginx.conf
#     e monte os certificados em /etc/nginx/certs (volume no docker-compose),
#     publicando as portas 80 e 443 em vez de 5173.
#  4. No .env, use FRONTEND_URL=https://clinica.exemplo.com.br

server_tokens off;

server {
    listen 80;
    server_name clinica.exemplo.com.br;
    # Toda requisicao HTTP vai para HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;  # requer nginx 1.25+ (a imagem do projeto usa 1.27)
    server_name clinica.exemplo.com.br;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:MedFlowSSL:10m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 10m;

    include /etc/nginx/conf.d/seguranca-headers.inc;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://backend:5000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/seguranca-headers.inc;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/seguranca-headers.inc;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}
