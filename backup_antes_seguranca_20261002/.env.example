# =====================================================================
# Sistema de Gestao para Clinica Odontologica -- variaveis de ambiente
#
# Copie este arquivo para ".env" e substitua os placeholders por valores
# reais. NUNCA faca commit do arquivo ".env" (veja .gitignore) nem coloque
# valores reais neste arquivo de exemplo.
# =====================================================================

# --- Flask ------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=TROCAR_ESTE_VALOR

# --- JWT (Flask-JWT-Extended) ------------------------------------------
JWT_SECRET_KEY=TROCAR_ESTE_VALOR
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- Banco de dados (MySQL) ---------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=clinica_odontologica
DB_USER=TROCAR_ESTE_VALOR
DB_PASSWORD=TROCAR_ESTE_VALOR
# Usado apenas pelo container mysql (docker-compose) para inicializar o
# usuario root do banco.
DB_ROOT_PASSWORD=TROCAR_ESTE_VALOR

# --- CORS / Frontend ------------------------------------------------------
# Origem(ns) permitida(s) para chamadas a API, separadas por virgula.
# NUNCA usar "*". Exemplo: https://app.clinica.com,https://admin.clinica.com
FRONTEND_URL=http://localhost:5173

# --- Rate limiting (Flask-Limiter) --------------------------------------
RATELIMIT_STORAGE_URI=memory://
